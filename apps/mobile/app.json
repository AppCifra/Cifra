{
  "expo": {
    "name": "cifra",
    "slug": "cifra",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icone.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0C0B",
    "android": {
      "package": "org.cifra.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icone-frente.png",
        "monochromeImage": "./assets/icone-mono.png",
        "backgroundColor": "#0B0C0B"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "./plugins/tela-segura.js",
      "./plugins/rede-onion.js",
      "./plugins/sem-backup.js",
      "./plugins/cmake-local.js",
      "./plugins/fontes.js",
      "./plugins/android-minimo.js",
      "./plugins/release-sem-log.js",
      "./plugins/assinatura.js",
      "./plugins/openssl.js"
    ]
  }
}
